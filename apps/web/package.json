{
  "name": "deputies-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:static-demo": "tsc --noEmit && VITE_STATIC_DEMO=true vite build --base /static-demo/ --outDir ../www/public/static-demo --emptyOutDir",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deputies/browser-milestones": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
